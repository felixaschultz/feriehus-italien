# Copy this file to .env.local and fill in real values
# (Do NOT commit .env.local — it is gitignored)

# From https://sanity.io/manage → your project → Settings → Project ID
PUBLIC_SANITY_PROJECT_ID=

# Usually "production" — leave as-is unless you created a different dataset
PUBLIC_SANITY_DATASET=

# Resend API key for the contact form — https://resend.com/api-keys
# In production, add this as a Cloudflare Worker secret:
#   wrangler secret put RESEND_API_KEY
RESEND_API_KEY=
