---
export const prerender = true;

import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import Section from "../components/Section.astro";
import AddressBlock from "../components/AddressBlock.astro";
import { fetchContactPage, fetchSiteSettings } from "../lib/queries";
import { urlFor } from "../lib/sanity";

const [data, settings] = await Promise.all([
  fetchContactPage(),
  fetchSiteSettings(),
]);

const fallback = {
  heroEyebrow: "Kontakt",
  heroTitle: "Lad os tale sammen",
  heroSubtitle:
    "Vi svarer hurtigt på spørgsmål om huset, ledige uger og praktiske oplysninger.",
  heroImage: "https://picsum.photos/seed/casa-contact-hero/2400/1300",
  heroImageAlt: "Kontakt Casa Santa Libera",

  formEyebrow: "Send en besked",
  formHeading: "Skriv til os",

  mapQuery: "Canelli, Asti, Italy",
};

const settingsFallback = {
  addressStreet: "Santa Libera-regionen 47",
  addressPostal: "14053 Canelli — Asti (AT)",
  addressCountry: "Italien",
  contact1Name: "Lars",
  contactEmail: "Lbejendomme@gmail.com",
  contactPhone: "+45 28 70 87 81",
  contact2Name: "Hans",
  contact2Email: "info@flytteboxen.dk",
  contact2Phone: "+45 30 95 18 48",
};

const heroImage = data?.heroImage
  ? urlFor(data.heroImage).width(2400).height(1300).fit("crop").auto("format").url()
  : fallback.heroImage;
const heroImageAlt = data?.heroImage?.alt || fallback.heroImageAlt;

const mapQuery = data?.mapQuery || fallback.mapQuery;
const mapSrc = `https://maps.google.com/maps?q=${encodeURIComponent(
  mapQuery,
)}&t=&z=13&ie=UTF8&iwloc=&output=embed`;

const street = settings?.addressStreet ?? settingsFallback.addressStreet;
const postal = settings?.addressPostal ?? settingsFallback.addressPostal;
const country = settings?.addressCountry ?? settingsFallback.addressCountry;

const contact1Name = settings?.contact1Name ?? settingsFallback.contact1Name;
const email = settings?.contactEmail ?? settingsFallback.contactEmail;
const phone = settings?.contactPhone ?? settingsFallback.contactPhone;

const contact2Name = settings?.contact2Name ?? settingsFallback.contact2Name;
const email2 = settings?.contact2Email ?? settingsFallback.contact2Email;
const phone2 = settings?.contact2Phone ?? settingsFallback.contact2Phone;
---

<BaseLayout
  title="Kontakt — Casa Santa Libera"
  description="Kontakt os for at høre om ledige uger, priser og praktisk information om Casa Santa Libera i Canelli, Piemonte."
>
  <Hero
    image={heroImage}
    imageAlt={heroImageAlt}
    eyebrow={data?.heroEyebrow ?? fallback.heroEyebrow}
    title={data?.heroTitle ?? fallback.heroTitle}
    subtitle={data?.heroSubtitle ?? fallback.heroSubtitle}
  />

  <Section>
    <div class="split">
      <div>
        <p class="eyebrow">{data?.formEyebrow ?? fallback.formEyebrow}</p>
        <h2 class="font-serif section-heading mt-4 mb-9">
          {data?.formHeading ?? fallback.formHeading}
        </h2>
        <form class="contact-form" id="contact-form" novalidate>
          <div>
            <label for="name">Navn</label>
            <input
              id="name"
              name="name"
              type="text"
              required
              placeholder="Dit fulde navn"
            />
          </div>
          <div>
            <label for="email">E-mail</label>
            <input
              id="email"
              name="email"
              type="email"
              required
              placeholder="dig@eksempel.dk"
            />
          </div>
          <div>
            <label for="dates">Ønskede datoer (valgfrit)</label>
            <input
              id="dates"
              name="dates"
              type="text"
              placeholder="F.eks. 12.–19. juli 2026"
            />
          </div>
          <div>
            <label for="message">Besked</label>
            <textarea
              id="message"
              name="message"
              required
              placeholder="Antal personer, særlige ønsker, spørgsmål..."></textarea>
          </div>
          <button type="submit" class="btn btn--solid">Send besked</button>
        </form>
      </div>
      <div>
        <AddressBlock heading="Adresse">
          <p>{street}</p>
          <p>{postal}</p>
          <p>{country}</p>
          <p class="mt-3 text-sm text-[rgba(45,42,38,0.6)]">
            Til GPS-navigation: Santa Libera-regionen 45, 14053 Canelli
          </p>
        </AddressBlock>
        <AddressBlock heading="Direkte kontakt">
          <div class="space-y-3">
            <div>
              <p class="font-medium">{contact1Name}</p>
              <p>
                <a href={`mailto:${email}`} class="text-[var(--color-terracotta)]">{email}</a>
              </p>
              {phone && (
                <p>
                  <a href={`tel:${phone.replace(/\s+/g, "")}`} class="text-[var(--color-terracotta)]">{phone}</a>
                </p>
              )}
            </div>
            {(email2 || phone2) && (
              <div>
                <p class="font-medium">{contact2Name}</p>
                {email2 && (
                  <p>
                    <a href={`mailto:${email2}`} class="text-[var(--color-terracotta)]">{email2}</a>
                  </p>
                )}
                {phone2 && (
                  <p>
                    <a href={`tel:${phone2.replace(/\s+/g, "")}`} class="text-[var(--color-terracotta)]">{phone2}</a>
                  </p>
                )}
              </div>
            )}
          </div>
        </AddressBlock>
        <AddressBlock heading="Find huset">
          <p>
            Vores nabo{" "}
            <a
              href="https://vinibocchino.it/"
              target="_blank"
              rel="noopener noreferrer"
              class="text-[var(--color-terracotta)]"
            >
              Vini Bocchino
            </a>{" "}
            (Santa Libera-regionen 43) hjælper gerne med at finde huset.
          </p>
        </AddressBlock>
        <iframe
          class="map-embed"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          src={mapSrc}
          title={`Kort over ${mapQuery}`}></iframe>
      </div>
    </div>
  </Section>
</BaseLayout>

<script>
  document.addEventListener("astro:page-load", () => {
    const form = document.getElementById("contact-form") as HTMLFormElement | null;
    const btn = form?.querySelector('button[type="submit"]') as HTMLButtonElement | null;
    if (!form || !btn) return;

    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      const data = Object.fromEntries(new FormData(form));
      btn.disabled = true;
      const originalLabel = btn.textContent ?? "Send besked";
      btn.textContent = "Sender…";

      try {
        const res = await fetch("/api/contact", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(data),
        });

        if (res.ok) {
          form.innerHTML =
            '<p class="success-message">Tak for din besked! Vi vender tilbage hurtigst muligt.</p>';
        } else {
          const payload = await res.json().catch(() => ({})) as { error?: string };
          alert(payload.error ?? "Der opstod en fejl — prøv igen eller skriv direkte til os.");
          btn.disabled = false;
          btn.textContent = originalLabel;
        }
      } catch {
        alert("Der opstod en fejl — prøv igen eller skriv direkte til os.");
        btn.disabled = false;
        btn.textContent = originalLabel;
      }
    });
  });
</script>
