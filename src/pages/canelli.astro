---
export const prerender = true;

import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import Section from "../components/Section.astro";
import SectionHeader from "../components/SectionHeader.astro";
import Cards from "../components/Cards.astro";
import CTA from "../components/CTA.astro";
import PortableText from "../components/PortableText.astro";
import { fetchCanelliPage } from "../lib/queries";
import { urlFor } from "../lib/sanity";
import canelliHeroImg from "../assets/IMG_2298.jpeg";
import santaLiberaImg from "../assets/feriehus-outdoor.jpg";
import alpsPanoramaImg from "../assets/canelli/alps-panorama.jpg";
import alpsMonvisoImg from "../assets/canelli/alps-monviso.jpg";

const data = await fetchCanelliPage();

// Fallback content (used when Sanity isn't configured or the document hasn't
// been published yet). Once the owner publishes content in /studio, that
// content takes over automatically.
const fallback = {
  heroEyebrow: "Området",
  heroTitle: "Canelli & Santa Libera",
  heroSubtitle: "Midt i Piemontes UNESCO-beskyttede vinlandskaber.",
  heroImage: canelliHeroImg.src,
  heroImageAlt: "Middag på terrassen med udsigt over vinmarkerne ved Canelli",

  introEyebrow: "Vinbyen",
  introHeading: "Italiens hjerte for mousserende vin",

  santaLiberaEyebrow: "Santa Libera",
  santaLiberaHeading:
    "Roligt og naturskønt — ganske få minutter fra centrum",
  santaLiberaImage: santaLiberaImg.src,
  santaLiberaImageAlt: "Vinmarker i Santa Libera-området ved Canelli",

  cathedralsEyebrow: "UNESCO-arv",
  cathedralsHeading: "De underjordiske katedraler i Canelli",
  cathedralsHouses: [
    {
      eyebrow: "Siden 1831",
      title: "Bosca",
      body: "Et af de ældste vinhuse i Canelli, kendt for sine mousserende vine og de imponerende kælderhvælv, der kan besøges efter aftale.",
    },
    {
      eyebrow: "Siden 1850",
      title: "Gancia",
      body: "Grundlagt af Carlo Gancia, manden bag Italiens allerførste mousserende vin i 1865, efter han lærte metoden at kende i Reims.",
    },
    {
      eyebrow: "Siden 1867",
      title: "Contratto",
      body: "Kendt for sin klassiske metode og de historiske kældergange, som stadig bruges til modning af husets spumante.",
    },
    {
      eyebrow: "Siden 1892",
      title: "Coppo",
      body: "Et af Piemontes toneangivende vinhuse, med rødder dybt i den lokale vinkultur og egne underjordiske kældre.",
    },
  ],

  experiencesEyebrow: "Oplev Piemonte",
  experiencesHeading: "Hvad du kan opleve",
  experiences: [
    {
      eyebrow: "Vinsmagninger",
      title: "Vingårde i verdensklasse",
      body: "Området omkring Canelli er hjem for nogle af Italiens mest respekterede vinproducenter. Bestil en privat vinsmagning hos en lokal producent — ofte gratis hvis I køber et par flasker med.",
    },
    {
      eyebrow: "Byer & kultur",
      title: "Asti, Alba & Barolo",
      body: "Charmerende middelalderbyer ligger i kort køreafstand. Asti er kendt for sin gastronomi, Alba for trøfler, og Barolo-området for nogle af verdens fineste rødvine.",
    },
    {
      eyebrow: "Natur",
      title: "Cykling & vandring",
      body: "De kuperede vinbakker er ideelle til både e-bike og lange vandreture. Lokale skilteruter fører jer forbi UNESCO's smukkeste udsigtspunkter — perfekt til en formiddag eller hel dag.",
    },
    {
      eyebrow: "Mad & marked",
      title: "Lokale markeder & gastronomi",
      body: "I Canelli er der marked tirsdag og fredag formiddag med friske grøntsager, oste, slagtervarer og specialiteter. Restauranterne i området serverer ægte piemontesisk køkken med en moderne tilgang.",
    },
  ],

  mapQuery: "Santa Libera, Canelli, Asti, Italy",

  ctaEyebrow: "Book dit ophold",
  ctaHeading: "Lyder Piemonte som dit næste eventyr?",
  ctaBody:
    "Vi svarer gerne på spørgsmål om huset, området og ledige uger.",
  ctaLabel: "Kontakt os",
};

const heroImage = data?.heroImage
  ? urlFor(data.heroImage).width(2400).height(1300).fit("crop").auto("format").url()
  : fallback.heroImage;
const heroImageAlt = data?.heroImage?.alt || fallback.heroImageAlt;

const santaLiberaImage = data?.santaLiberaImage
  ? urlFor(data.santaLiberaImage)
      .width(900)
      .height(1100)
      .fit("crop")
      .auto("format")
      .url()
  : fallback.santaLiberaImage;
const santaLiberaImageAlt =
  data?.santaLiberaImage?.alt || fallback.santaLiberaImageAlt;

const experiences = data?.experiences?.length
  ? data.experiences
  : fallback.experiences;

const mapQuery = data?.mapQuery || fallback.mapQuery;
const mapSrc = `https://maps.google.com/maps?q=${encodeURIComponent(
  mapQuery,
)}&t=&z=11&ie=UTF8&iwloc=&output=embed`;
---

<BaseLayout
  title="Canelli & Santa Libera — Casa Santa Libera"
  description="Canelli er en af Italiens vigtigste vinbyer, kendt for mousserende vine og UNESCO-beskyttede underjordiske vinkældre. Læs mere om området omkring Casa Santa Libera."
>
  <Hero
    image={heroImage}
    imageAlt={heroImageAlt}
    eyebrow={data?.heroEyebrow ?? fallback.heroEyebrow}
    title={data?.heroTitle ?? fallback.heroTitle}
    subtitle={data?.heroSubtitle ?? fallback.heroSubtitle}
  />

  <Section narrow>
    <p class="eyebrow">{data?.introEyebrow ?? fallback.introEyebrow}</p>
    <h2 class="font-serif section-heading mt-4">
      {data?.introHeading ?? fallback.introHeading}
    </h2>
    <div class="lead mt-8">
      {
        data?.introBody ? (
          <PortableText blocks={data.introBody} />
        ) : (
          <p>
            Canelli er kendt som en af Italiens vigtigste vinbyer og er især
            berømt for sine mousserende vine. Byen byder på hyggelige
            restauranter, vinbarer og historiske vinkældre — bl.a. de
            UNESCO-beskyttede "underjordiske katedraler".
          </p>
        )
      }
    </div>
  </Section>

  <Section variant="white">
    <SectionHeader
      eyebrow={fallback.cathedralsEyebrow}
      heading={fallback.cathedralsHeading}
      centered
    />
    <div class="lead mt-7 mx-auto max-w-[760px] text-center">
      <p>
        Under Canellis gader gemmer sig et af Italiens mest opsigtsvækkende
        vinbygningsværker: et net af snoede kældre og gange, udhugget i den
        bløde tufklippe mellem 1500- og 1800-tallet. De kaldes "de
        underjordiske katedraler" på grund af deres høje, hvælvede lofter,
        der minder om kirkerum — nogle steder når gangene 32 meter under
        jorden, og tilsammen strækker de sig omkring 20 kilometer gennem
        bakken.
      </p>
      <p class="mt-5">
        Det var vinhandleren Carlo Gancia, der i midten af 1800-tallet tog
        metoden med til Canelli efter et ophold i Reims, hvor han lærte
        champagnens hemmeligheder at kende. Siden har kældrenes naturligt
        stabile temperatur på 12-14 grader gjort dem ideelle til modning af
        mousserende vin efter den klassiske metode — bl.a. den berømte Asti
        Spumante.
      </p>
      <p class="mt-5">
        I 2014 kom de underjordiske katedraler på UNESCO's verdensarvsliste
        som en del af "Vinlandskabet i Piemonte: Langhe-Roero og
        Monferrato" — verdens første verdensarvsområde udelukkende viet til
        vinkultur. I dag ejes og passes kældrene af fire historiske vinhuse,
        som alle kan besøges efter aftale.
      </p>
    </div>
    <div class="mt-12">
      <Cards cards={fallback.cathedralsHouses} />
    </div>
  </Section>

  <Section variant="soft">
    <div class="split">
      <img
        class="aspect-landscape"
        src={alpsPanoramaImg.src}
        alt="Panoramaudsigt fra vinbakkerne i Langhe med Alperne og Monviso i baggrunden"
        loading="lazy"
      />
      <div>
        <p class="eyebrow">Udsigten</p>
        <h2 class="font-serif section-heading mt-4">Alperne i baggrunden</h2>
        <div class="lead mt-7">
          <p>
            På klare dage kan I se de snedækkede Alper — med den markante
            Monviso-tinde i horisonten — hele vejen fra vinbakkerne omkring
            Canelli.
          </p>
        </div>
      </div>
    </div>
  </Section>

  <Section variant="white">
    <div class="split">
      <div>
        <p class="eyebrow">
          {data?.santaLiberaEyebrow ?? fallback.santaLiberaEyebrow}
        </p>
        <h2 class="font-serif section-heading mt-4">
          {data?.santaLiberaHeading ?? fallback.santaLiberaHeading}
        </h2>
        <div class="lead mt-7">
          {
            data?.santaLiberaBody ? (
              <PortableText blocks={data.santaLiberaBody} />
            ) : (
              <p>
                Casa Santa Libera ligger i et stille område omgivet af
                vinmarker og bakker, men kun en kort køretur fra Canellis
                hyggelige torv, caféer og vinbarer. Her får I det bedste fra to
                verdener: ro og udsigt om dagen, italiensk byliv om aftenen.
              </p>
            )
          }
        </div>
      </div>
      <img
        class="aspect-portrait"
        src={santaLiberaImage}
        alt={santaLiberaImageAlt}
        loading="lazy"
      />
    </div>
  </Section>

  <Section variant="olive">
    <div class="split">
      <img
        class="aspect-portrait"
        src={alpsMonvisoImg.src}
        alt="Monviso-tinden i Alperne set fra vinmarkerne i Piemonte ved solnedgang"
        loading="lazy"
      />
      <div>
        <p class="eyebrow on-dark">Monviso</p>
        <h2 class="font-serif section-heading mt-4">
          Piemontes egen bjergtop
        </h2>
        <div class="lead mt-7">
          <p>
            Monviso er den højeste top i de Cottiske Alper og et markant
            vartegn, der troner i horisonten over vinlandskabet. Om aftenen,
            når solen går ned bag toppen, farves himlen og vinmarkerne i
            varme nuancer — et af områdets smukkeste synsindtryk.
          </p>
        </div>
      </div>
    </div>
  </Section>

  <Section variant="soft">
    <SectionHeader
      eyebrow={data?.experiencesEyebrow ?? fallback.experiencesEyebrow}
      heading={data?.experiencesHeading ?? fallback.experiencesHeading}
      centered
    />
    <Cards cards={experiences} />
  </Section>

  <Section variant="white">
    <SectionHeader eyebrow="På kortet" heading="Sådan finder du os" centered />
    <iframe
      class="map-embed"
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      src={mapSrc}
      title={`Kort over ${mapQuery}`}
    ></iframe>
  </Section>

  <CTA
    variant="olive"
    eyebrow={data?.ctaEyebrow ?? fallback.ctaEyebrow}
    heading={data?.ctaHeading ?? fallback.ctaHeading}
    body={data?.ctaBody ?? fallback.ctaBody}
    ctaLabel={data?.ctaLabel ?? fallback.ctaLabel}
    ctaHref="/kontakt/"
    ctaStyle="light"
  />
</BaseLayout>
